<Window x:Class="lab0.CoordRect"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:lab0"
        mc:Ignorable="d"
        Title="CoordRect" Height="200" Width="450">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">x</TextBlock>
        <TextBlock Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">y</TextBlock>
        <TextBlock Grid.Row="1" Grid.Column="0">Точка 1</TextBlock>
        <TextBlock Grid.Row="2" Grid.Column="0">Длина</TextBlock>
        <TextBlock Grid.Row="3" Grid.Column="0">Ширина</TextBlock>
        <TextBox Grid.Row="1" Grid.Column="1" Background="Pink" Name="X1"></TextBox>
        <TextBox Grid.Row="1" Grid.Column="2" Background="Pink" Name="Y1"></TextBox>
        <TextBox Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="2" Background="Pink" Name="Width"></TextBox>
        <TextBox Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="3" Background="Pink" Name="Height"></TextBox>
        <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Click="CreateRectangle">Создать</Button>
    </Grid>
</Window>
